{
  "name": "PendingSpeciesUpdate",
  "type": "object",
  "properties": {
    "species_id": {
      "type": "string",
      "description": "ID of the existing species record"
    },
    "scientific_name": {
      "type": "string",
      "description": "Scientific name for reference"
    },
    "current_data": {
      "type": "object",
      "description": "Current species data before update"
    },
    "new_data": {
      "type": "object",
      "description": "New data fields to be updated"
    },
    "data_source": {
      "type": "string",
      "description": "Source of the new data (IUCN, iNaturalist, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "Review status"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description or notes for this record"
    }
  },
  "required": [
    "species_id",
    "scientific_name",
    "new_data",
    "data_source"
  ]
}