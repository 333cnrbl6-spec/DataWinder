{
  "name": "SpeciesNote",
  "type": "object",
  "properties": {
    "species_scientific_name": {
      "type": "string",
      "description": "Scientific name of the species"
    },
    "note": {
      "type": "string",
      "description": "Personal observation or note"
    },
    "observation_date": {
      "type": "string",
      "format": "date",
      "description": "Date of observation"
    },
    "location": {
      "type": "string",
      "description": "Location of observation"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorizing notes"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description or notes for this record"
    }
  },
  "required": [
    "species_scientific_name",
    "note"
  ]
}