{
  "name": "BoardInvite",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string",
      "description": "Name of app being invited"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of app representative"
    },
    "role": {
      "type": "string",
      "description": "Board role title"
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App's expertise areas"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "invited_by": {
      "type": "string",
      "description": "Email of inviter"
    },
    "invited_date": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "app_name",
    "recipient_email"
  ]
}